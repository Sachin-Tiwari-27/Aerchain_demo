NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_API_KEY=

# Optional image parsing providers. RFx JSON extraction stays Gemini-only.
GEMINI_IMAGE_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_IMAGE_SECONDARY_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_PRIMARY_MODEL=minimax/minimax-m3:free
OPENROUTER_IMAGE_SECONDARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# RFx extraction and AI conversation models.
GEMINI_RFX_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_RFX_SECONDARY_MODEL=gemini-3.5-flash-lite
OPENROUTER_RFX_PRIMARY_MODEL=minimax/minimax-m3:free
OPENROUTER_RFX_SECONDARY_MODEL=thinkingmachines/inkling:free

# RFx drafting (conversational buyer message -> RFx description/category).
GEMINI_RFX_DRAFT_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_RFX_DRAFT_SECONDARY_MODEL=gemini-3.5-flash-lite
# OpenRouter is tried first for rfx-draft; MiniMax M3 (free) is the default.
# No openrouter-secondary is used for rfx-draft; the chain falls back to Gemini.
OPENROUTER_RFX_DRAFT_PRIMARY_MODEL=minimax/minimax-m3:free
OPENROUTER_RFX_DRAFT_SECONDARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Analyst intent routing (question -> tool name).
GEMINI_ANALYST_INTENT_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_ANALYST_INTENT_SECONDARY_MODEL=gemini-3.5-flash-lite
OPENROUTER_ANALYST_INTENT_PRIMARY_MODEL=minimax/minimax-m3:free
OPENROUTER_ANALYST_INTENT_SECONDARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Analyst recommendation (buyer-facing award narrative).
GEMINI_ANALYST_RECOMMENDATION_PRIMARY_MODEL=gemini-3.1-flash
GEMINI_ANALYST_RECOMMENDATION_SECONDARY_MODEL=gemini-3.5-flash-lite
OPENROUTER_ANALYST_RECOMMENDATION_PRIMARY_MODEL=minimax/minimax-m3:free
OPENROUTER_ANALYST_RECOMMENDATION_SECONDARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free